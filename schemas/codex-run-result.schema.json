{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.internal/schemas/codex-run-result.schema.json",
  "title": "Codex Playwright MCP Observed Run Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runId",
    "caseId",
    "mode",
    "observedStatus",
    "authoritativeStatus",
    "startedAt",
    "endedAt",
    "steps",
    "assertions",
    "evidence",
    "classification",
    "assumptions",
    "versions",
    "error"
  ],
  "properties": {
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "caseId": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "enum": ["explore", "assist"]
    },
    "observedStatus": {
      "type": "string",
      "enum": [
        "observed-pass",
        "observed-fail",
        "blocked",
        "review-required"
      ]
    },
    "authoritativeStatus": {
      "type": "null"
    },
    "startedAt": {
      "type": "string",
      "minLength": 1
    },
    "endedAt": {
      "type": "string",
      "minLength": 1
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "assertions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assertion"
      }
    },
    "evidence": {
      "$ref": "#/$defs/evidence"
    },
    "classification": {
      "$ref": "#/$defs/classification"
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "versions": {
      "$ref": "#/$defs/versions"
    },
    "error": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "message", "code"],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string"
            },
            "code": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "intent",
        "action",
        "status",
        "locatorUsed",
        "durationMs",
        "error"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "intent": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "action": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "observed-pass",
            "observed-fail",
            "blocked",
            "review-required"
          ]
        },
        "locatorUsed": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "status",
        "actual",
        "durationMs",
        "error"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "observed-pass",
            "observed-fail",
            "blocked",
            "review-required"
          ]
        },
        "actual": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trace",
        "snapshot",
        "screenshot",
        "networkSummary",
        "consoleSummary"
      ],
      "properties": {
        "trace": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "snapshot": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "screenshot": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "networkSummary": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "consoleSummary": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "confidence", "reviewRequired", "summary"],
      "properties": {
        "category": {
          "type": "string",
          "enum": [
            "product_bug",
            "test_bug",
            "locator_drift",
            "environment_issue",
            "flaky_test",
            "unknown"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reviewRequired": {
          "type": "boolean"
        },
        "summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codex", "playwrightMcp", "skill"],
      "properties": {
        "codex": {
          "type": "string",
          "minLength": 1
        },
        "playwrightMcp": {
          "type": "string",
          "minLength": 1
        },
        "skill": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
