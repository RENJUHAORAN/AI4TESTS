{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai4tests.local/schemas/discovery-manifest.schema.json",
  "title": "UI Discovery Manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "generatedAt",
    "status",
    "configPath",
    "outputDir",
    "source",
    "runtime",
    "reconciliation",
    "catalog",
    "coverage",
    "caveats"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"type": "string"},
    "runId": {"type": "string"},
    "generatedAt": {"type": "string"},
    "status": {"enum": ["review-required", "complete"]},
    "configPath": {"type": "string"},
    "outputDir": {"type": "string"},
    "source": {"$ref": "#/$defs/stage"},
    "runtime": {"$ref": "#/$defs/stage"},
    "reconciliation": {"type": "object"},
    "catalog": {"type": "object"},
    "coverage": {
      "type": "object",
      "required": ["route", "transition", "role", "process"],
      "additionalProperties": false,
      "properties": {
        "route": {"$ref": "#/$defs/metric"},
        "transition": {"$ref": "#/$defs/metric"},
        "role": {"$ref": "#/$defs/metric"},
        "process": {"$ref": "#/$defs/metric"}
      }
    },
    "caveats": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "$defs": {
    "stage": {
      "type": "object",
      "required": ["status", "stats"],
      "additionalProperties": false,
      "properties": {
        "status": {"type": "string"},
        "stats": {"type": "object"}
      }
    },
    "metric": {
      "type": "object",
      "required": ["covered", "total", "ratio", "basis"],
      "additionalProperties": false,
      "properties": {
        "covered": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 0},
        "ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "basis": {"type": "string"}
      }
    }
  }
}
