{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai4tests.local/schemas/process-catalog.schema.json",
  "title": "UI Business Process Catalog",
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "generatedAt",
    "status",
    "sourceReconciliationRunId",
    "maxDepth",
    "processes",
    "processFiles",
    "summary",
    "caveats"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"type": "string"},
    "runId": {"type": "string"},
    "generatedAt": {"type": "string"},
    "status": {"enum": ["review-required", "complete"]},
    "sourceReconciliationRunId": {"type": ["string", "null"]},
    "maxDepth": {"type": "integer", "minimum": 1},
    "processes": {
      "type": "array",
      "items": {"$ref": "#/$defs/process"}
    },
    "processFiles": {
      "type": "array",
      "items": {"type": "string"}
    },
    "summary": {"type": "object"},
    "caveats": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "$defs": {
    "process": {
      "type": "object",
      "required": [
        "schemaVersion",
        "id",
        "title",
        "status",
        "category",
        "roles",
        "preconditions",
        "entryPath",
        "outcome",
        "steps",
        "branches",
        "apiDependencies",
        "evidence",
        "coverage",
        "risk",
        "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {"type": "string"},
        "id": {"type": "string"},
        "title": {"type": "string"},
        "status": {
          "enum": [
            "matched",
            "source-only",
            "runtime-only",
            "conflict",
            "blocked"
          ]
        },
        "category": {"type": "string"},
        "roles": {
          "type": "array",
          "items": {"type": "string"}
        },
        "preconditions": {
          "type": "array",
          "items": {"type": "string"}
        },
        "entryPath": {"type": "string"},
        "outcome": {"type": "object"},
        "steps": {
          "type": "array",
          "items": {"type": "object"}
        },
        "branches": {"type": "array"},
        "apiDependencies": {"type": "array"},
        "evidence": {"type": "array"},
        "coverage": {"type": "object"},
        "risk": {"type": "object"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
