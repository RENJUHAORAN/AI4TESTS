{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.internal/schemas/run-result.schema.json",
  "title": "UI Test Run Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "caseId",
    "mode",
    "status",
    "startedAt",
    "endedAt",
    "durationMs",
    "steps",
    "assertions",
    "evidence",
    "versions",
    "reviewRequired"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "caseId": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": ["verify", "explore", "assist"]
    },
    "status": {
      "enum": ["passed", "failed", "blocked"]
    },
    "startedAt": {
      "type": "string",
      "minLength": 1
    },
    "endedAt": {
      "type": "string",
      "minLength": 1
    },
    "durationMs": {
      "type": "integer",
      "minimum": 0
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stepResult"
      }
    },
    "assertions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assertionResult"
      }
    },
    "evidence": {
      "$ref": "#/$defs/evidence"
    },
    "versions": {
      "$ref": "#/$defs/versions"
    },
    "reviewRequired": {
      "type": "boolean"
    },
    "error": {
      "$ref": "#/$defs/error"
    }
  },
  "$defs": {
    "stepResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "intent", "action", "status", "durationMs"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "intent": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": ["passed", "failed"]
        },
        "locatorUsed": {
          "type": "string"
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0
        },
        "error": {
          "type": "string"
        }
      }
    },
    "assertionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "status", "durationMs"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": ["passed", "failed"]
        },
        "actual": {
          "type": ["string", "number", "boolean", "object", "array", "null"]
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0
        },
        "error": {
          "type": "string"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trace": {
          "type": "string",
          "minLength": 1
        },
        "screenshot": {
          "type": "string",
          "minLength": 1
        },
        "accessibilitySnapshot": {
          "type": "string",
          "minLength": 1
        },
        "console": {
          "type": "string",
          "minLength": 1
        },
        "network": {
          "type": "string",
          "minLength": 1
        },
        "captureError": {
          "type": "string"
        }
      }
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runner",
        "python",
        "playwright",
        "contractSha256",
        "environment"
      ],
      "properties": {
        "runner": {
          "type": "string",
          "minLength": 1
        },
        "python": {
          "type": "string",
          "minLength": 1
        },
        "playwright": {
          "type": "string",
          "minLength": 1
        },
        "contractSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "environment": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "message", "code"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        },
        "code": {
          "type": ["string", "null"]
        }
      }
    }
  }
}
